<style>
	/* Scoped to this page. A previous version was `is:global`, which leaked
	   .flame, .glow and .tn into every page on the site. Prefixed so the candle
	   classes cannot collide with a future component. */
	.al-rng {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 44px;
		background: transparent;
		cursor: ew-resize;
	}
	.al-rng::-webkit-slider-runnable-track {
		height: 2px;
		background: var(--color-brass);
	}
	.al-rng::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 28px;
		height: 28px;
		margin-top: -13px;
		border-radius: 50%;
		background: var(--color-navy);
		border: 3px solid var(--color-brass-light);
	}
	.al-rng::-moz-range-track {
		height: 2px;
		background: var(--color-brass);
	}
	.al-rng::-moz-range-thumb {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--color-navy);
		border: 3px solid var(--color-brass-light);
	}
	@keyframes al-flicker {
		0%, 100% { transform: scale(1) translateY(0); opacity: 1; }
		35% { transform: scale(0.94, 1.06) translateY(-1px); opacity: 0.92; }
		70% { transform: scale(1.04, 0.96); opacity: 1; }
	}
	@keyframes al-glow {
		0%, 100% { opacity: 0.85; }
		50% { opacity: 1; }
	}
	/* prefers-reduced-motion is already handled globally in global.css, so this
	   page does not repeat it. */
	.al-flame { animation: al-flicker 2.6s ease-in-out infinite; transform-origin: 50% 100%; }
	.al-glow { animation: al-glow 3.2s ease-in-out infinite; }
</style>

<script>
	// Year ribbon: choose a batch year and the caption, heading and status follow.
	const batches = document.querySelector<HTMLElement>("[data-batches]");
	if (batches) {
		const buttons = [...batches.querySelectorAll<HTMLButtonElement>("[data-year]")];
		const status = batches.querySelector("[data-batch-status]");
		const show = (year: string) => {
			batches.querySelectorAll("[data-batch-year]").forEach((el) => (el.textContent = year));
			if (status) status.textContent = `Showing batch of ${year}`;
		};
		buttons.forEach((b) =>
			b.addEventListener("click", () => {
				buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
				show(b.dataset.year ?? "");
				// The ribbon scrolls horizontally, so a year at either end can be
				// chosen and then left sitting half off-screen. `nearest` on both
				// axes brings the pressed year into view and leaves the page
				// exactly where it was, which the load path still never does.
				b.scrollIntoView({ block: "nearest", inline: "nearest" });
			}),
		);
		// No scrollIntoView on load: the page moved itself under nobody's request.
	}

	// Directory: name, batch, city or country, narrowed by house, decade and
	// country. Every term is OR'd, so "Chennai" and "1998" both find rows.
	const dir = document.querySelector<HTMLElement>("[data-directory]");
	if (dir) {
		// `@cloudflare/workers-types` does not model HTMLSelectElement, so these
		// are typed by the two members actually used.
		type Field = HTMLInputElement | (HTMLSelectElement & { value: string });
		const q = dir.querySelector("[data-q]") as Field | null;
		const house = dir.querySelector("[data-house]") as Field | null;
		const decade = dir.querySelector("[data-decade]") as Field | null;
		const chips = [...dir.querySelectorAll("[data-country]")] as HTMLButtonElement[];
		const cards = [...dir.querySelectorAll("[data-person]")] as HTMLElement[];
		const count = dir.querySelector("[data-count]");
		const dirStatus = dir.querySelector("[data-dir-status]");
		const empty = dir.querySelector("[data-empty]") as HTMLElement | null;
		let country = "All";
		let said = -1;

		if (!q || !house || !decade) throw new Error("Alumni directory filters are missing their inputs");

		const apply = () => {
			// Comma-separated terms are OR'd, which is what the placeholder promises.
			const terms = q.value.toLowerCase().split(",").map((t) => t.trim()).filter(Boolean);
			const houseValue = house.value;
			const decadeValue = decade.value;
			let n = 0;
			cards.forEach((c) => {
				const batch = Number(c.dataset.batch);
				const haystack = [c.dataset.name, c.dataset.batch, c.dataset.city, c.dataset.country, c.dataset.house]
					.filter(Boolean)
					.join(" ")
					.toLowerCase();
				const ok =
					(country === "All" || c.dataset.country === country) &&
					(!houseValue || c.dataset.house === houseValue) &&
					(!decadeValue || batch >= Number(decadeValue) && batch < Number(decadeValue) + 10) &&
					(!terms.length || terms.some((t) => haystack.includes(t)));
				c.hidden = !ok;
				if (ok) n++;
			});
			if (count) count.textContent = String(n);
			if (empty) empty.hidden = n > 0;
			// The live region carries the count and nothing else — no permanent
			// copy, no controls — so it is not re-read on every update. It still
			// speaks on every keystroke, because the count is the feedback, but
			// only when the count actually moves.
			if (n !== said) {
				said = n;
				// `cards.length`, not `people.length`: a bundled <script> cannot
				// read the frontmatter, and the cards are the people.
				if (dirStatus) dirStatus.textContent = `${n} of ${cards.length} sample entries match`;
			}
		};

		const reset = () => {
			q.value = "";
			house.value = "";
			decade.value = "";
			country = "All";
			chips.forEach((x, i) => x.setAttribute("aria-pressed", String(i === 0)));
			apply();
			q.focus();
		};

		([q, house, decade] as Field[]).forEach((el) => el.addEventListener("input", apply));
		dir.querySelector("[data-clear]")?.addEventListener("click", reset);
		chips.forEach((b) =>
			b.addEventListener("click", () => {
				country = b.dataset.country ?? "All";
				chips.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
				apply();
			}),
		);
	}

	// Then & Now: the range moves the reveal line and says where it landed.
	const cmp = document.querySelector<HTMLElement>("[data-compare]");
	if (cmp) {
		const stage = cmp.querySelector<HTMLElement>("[data-stage]");
		const range = cmp.querySelector<HTMLInputElement>("input[type=range]");
		const status = cmp.querySelector("[data-compare-status]");
		if (!stage || !range) throw new Error("Then & Now compare is missing its stage or range");
		const phrase = (v: number) =>
			v < 10 ? "Almost all now" : v > 90 ? "Almost all then" : v < 45 ? "Mostly now" : v > 55 ? "Mostly then" : "Halfway between then and now";
		let said = phrase(Number(range.value));
		range.addEventListener("input", () => {
			stage.style.setProperty("--pos", `${range.value}%`);
			const text = phrase(Number(range.value));
			// aria-valuetext has to track the thumb: it *is* the value a screen
			// reader reads out. The live region must not. `input` fires for every
			// pixel of a drag, and rewriting the region each time queues the same
			// five phrases dozens deep, so it only speaks when the phrase changes.
			range.setAttribute("aria-valuetext", text);
			if (text !== said) {
				said = text;
				if (status) status.textContent = text;
			}
		});
	}
</script>
