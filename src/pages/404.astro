---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
---

<Base title="Page not found">
	<section class="mx-auto flex max-w-2xl flex-col items-center gap-6 px-4 py-28 text-center">
		<h1 class="font-serif text-5xl md:text-7xl">Lost in the mist</h1>
		<p class="lede muted">This page does not exist, or it has moved. The mist is thick here.</p>
		<div class="flex flex-wrap justify-center gap-4">
			<Button href="/">Go to the home page</Button>
			<Button href="/contact" variant="outline">Tell us what you were looking for</Button>
		</div>
	</section>
</Base>
