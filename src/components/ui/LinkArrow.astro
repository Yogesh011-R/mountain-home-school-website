---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	href: string;
	/** Use on navy or photo backgrounds. */
	onDark?: boolean;
}

const { class: className, onDark = false, ...rest } = Astro.props;
---

<a
	class:list={[
		"inline-flex min-h-11 items-center gap-2 font-semibold no-underline hover:underline",
		onDark ? "text-mustard-tint hover:text-cream" : "text-brick hover:text-brick-dark",
		className,
	]}
	{...rest}
>
	<slot /> <span aria-hidden="true">→</span>
</a>
