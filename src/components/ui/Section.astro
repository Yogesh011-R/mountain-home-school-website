---
// Page section with the site's standard width and vertical rhythm.
interface Props {
	/** id of the heading, wired to aria-labelledby. */
	labelledby?: string;
	label?: string;
	/** Full-bleed background classes, e.g. "bg-mustard-tint". Content stays width-limited. */
	bg?: string;
	class?: string;
	/** Classes for the inner width-limited wrapper. */
	innerClass?: string;
	id?: string;
}

const { labelledby, label, bg, class: className, innerClass, id } = Astro.props;
---

<section id={id} aria-labelledby={labelledby} aria-label={label} class:list={["relative", bg, className]}>
	<div class:list={["mx-auto max-w-site px-4 py-16 lg:px-30 lg:py-24", innerClass]}>
		<slot />
	</div>
</section>
